# Godot 4+ specific ignores
.godot/
/android/

# Legacy Godot ignores
.import/
export.cfg
/export_presets.cfg

# Root README screenshot import files (not used as in-game resources)
/LastLight-*.png.import

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Build, staging, and release distribution outputs
/build/
/dist/
*.exe
*.pck
*.apk
*.aab

# Editor plugin update backups
addons/.godot_ai_update/

# Python cache & virtual environments (used by tools/)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
*~

# OS and IDE files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
